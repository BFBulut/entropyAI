# --- Faz 11-A depo temizligi (2026-09-10) ---
# Uretilmis ikili cikti (PyInstaller); spec ile yeniden uretilir.
dist*/
build*/

# Denetim/olcum gunlukleri ve gecici scratch ciktilari.
scratch/_*.log
scratch/_*.js
scratch/_*.html
# scratch/ bir olcum tezgahidir: ekran goruntuleri, fikstur ciktilari, gecici
# betikler. Halihazirda IZLENEN 55 dosya etkilenmez (gitignore izlenen dosyayi
# kapsamaz); yalnizca yeni uretilen cikti git'e sizmaz.
scratch/

# Entropy'nin derledigi ajan tanimlari APP_ROOT'a da yaziliyor (compile.py).
# Izlenen .agents/agents/distiller etkilenmez: gitignore izlenen dosyayi kapsamaz.
.agents/

